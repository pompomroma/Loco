# ---------------------------------------------------------------------------
# Loco environment variables
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# NEVER commit real keys. `.env.local` must stay out of version control.
# ---------------------------------------------------------------------------

# Your NVIDIA API key (OpenAI-compatible). Get / rotate it at:
#   https://build.nvidia.com  (Account -> API Keys)
# Server-side only. It is read by app/api/chat/route.ts and never sent to the browser.
NVIDIA_API_KEY=

# NVIDIA OpenAI-compatible base URL. Default is correct for build.nvidia.com.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# The Nemotron model slug to call. VERIFY the exact id in the NVIDIA model
# catalog (https://build.nvidia.com/models) — slugs change between releases.
# Examples seen in the catalog: nvidia/llama-3.1-nemotron-ultra-253b-v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ---- Performance defaults (all optional; maxed out of the box) -------------
# Output budget per turn. Default 8192. If a model's own ceiling is lower, the
# app automatically retries without the cap so the model's maximum applies.
NVIDIA_MAX_TOKENS=
# Sampling temperature. Default 0.2 (precise, deterministic code).
NVIDIA_TEMPERATURE=
# Llama-Nemotron reasoning toggle: "on" = more deliberate (slower), "off" =
# fastest. Leave unset to use the model's own default. This is the one real
# intelligence-vs-speed trade-off — no setting gives both maxima at once.
NVIDIA_REASONING=

# Optional: URL of a separate always-on execution worker (VPS/container host)
# that runs the Docker sandbox + file/format/binary tooling. Leave blank on
# Vercel — those features then degrade gracefully with an honest notice.
EXECUTION_WORKER_URL=
